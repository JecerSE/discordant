# For editors other than Godot's own (VS Code, Neovim, ...): match Godot's GDScript style.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gd,tscn,tres,cfg,godot}]
indent_style = tab
indent_size = 4

[*.{md,sh,py,json,yml,yaml}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
